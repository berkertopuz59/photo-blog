# Where the site is served. Admin requests are checked against this origin.
SITE_URL=https://photos.example.com

# Shown on the site
SITE_TITLE=Your Name
SITE_TAGLINE=Photographs
# Optional link to your blog in the header
BLOG_URL=

# Admin login. Use a random username: openssl rand -hex 8
ADMIN_USERNAME=
# node scripts/hash-password.js
ADMIN_PASSWORD_HASH=

# openssl rand -hex 32
SESSION_SECRET=
VISITOR_SECRET=

# Cloudflare Turnstile keys for your domain
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional AI caption drafts. Any OpenAI-compatible API with a vision model.
# Drafts wait for your approval in the admin.
CAPTION_API_URL=
CAPTION_API_KEY=
CAPTION_MODEL=

# Set to 1 only when the site can be reached through Cloudflare alone.
# It trusts the CF-Connecting-IP header for rate limiting.
TRUST_CF=0
